index 0000000..99eaea4
--- /dev/null
+++ b/tests/viking_native_driver.cpp
@@ -0,0 +1,51 @@
+#include "orbit/native_provider.hpp"
+#include "orbit/api.hpp"
+#include "orbit/i18n.hpp"
+#include <cassert>
+#include <iostream>
+using namespace orbit;
+// The test exercises protocol and dialog ownership independently of language.
+namespace orbit::i18n { const char *tr(const char *text) { return text; } }
+struct Transport : http::Transport {
+    http::Request last;
+    http::Response send(const http::Request &request) override {
+        last=request;
+        http::Response reply;reply.status=202;
+        reply.body=R"({"available":true,"signInAvailable":true,"signIn":true,"active":true,"id":"login","state":"opening"})";
+        return reply;
+    }
+};
+struct Window : ProviderWindow {
+    int state=2,opens=0,closes=0;
+    std::string page;
+    bool open(const std::string &url) override { page=url;++opens;return true; }
+    int status() override { return state; }
+    int close() override { ++closes;return 0; }
+};
+int main() {
+    Transport transport;api::Client client(transport);client.set_token("test-session");
+    const auto login=client.start_browser({}, {}, "owner", true);
+    assert(login.ok() && login.value.sign_in_available && login.value.sign_in);
+    assert(transport.last.body==R"({"action":"sign-in","sourceId":"vikingfile","returnTarget":"native","nativeDialog":true,"clientId":"owner"})");
+    assert(transport.last.path=="/api/v1/browser" && transport.last.bearer=="test-session");
+    assert(client.start_browser("release","internal","owner").ok());
+    assert(transport.last.body==R"({"action":"start","releaseId":"release","storageId":"internal","returnTarget":"native","nativeDialog":true,"clientId":"owner"})");
+    Window window;NativeProvider provider;provider.set_window(&window);
+    BrowserSession s;s.id="login";s.client_id="owner";s.active=true;s.sign_in=true;
+    s.state="opening";s.page_url="https://vikingfile.com/login";
+    provider.begin("owner",0);
+    assert(provider.tick(s,true,1).kind==NativeProvider::Event::opened);
+    assert(window.page==s.page_url && window.opens==1);
+    s.state="waiting";s.dialog_opened=true;provider.tick(s,true,2);assert(window.closes==0);
+    window.state=3;
+    assert(provider.tick(s,true,3).kind==NativeProvider::Event::cancel);
+    assert(!provider.busy() && s.job_id.empty());
+    // A later download uses the very same ProviderWindow/profile.
+    provider.begin("next-owner",4);s.id="download";s.client_id="next-owner";s.sign_in=false;
+    s.state="opening";s.dialog_opened=false;s.page_url="https://vikingfile.com/f/EXAMPLE123";window.state=2;
+    assert(provider.tick(s,true,5).kind==NativeProvider::Event::opened);
+    assert(window.opens==2);s.state="queued";s.job_id="download-job";
+    provider.tick(s,true,6);assert(window.closes==1);
+    window.state=3;assert(provider.tick(s,true,7).kind==NativeProvider::Event::none);
+    std::cout<<"Native sign-in dialog lifecycle checks passed\n";
+}
diff --git a/tests/viking_sign_in_driver.c b/tests/viking_sign_in_driver.c
new file mode 100644
index 0000000..7a19f74
--- /dev/null
+++ b/tests/viking_sign_in_driver.c
@@ -0,0 +1,101 @@
+/* Offline browser-session regression tests. No accounts or network required. */
+#include "orbit.h"
+#include "browser_platform.h"
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+Orbit orbit = {.mutex = PTHREAD_MUTEX_INITIALIZER, .changed = PTHREAD_COND_INITIALIZER};
+static atomic_int opens, captures, validations, jobs;
+static int open_result;
+static Release release = {.id="example", .source="vikingfile", .title="Example",
+    .browser_url="https://vikingfile.com/f/EXAMPLE123", .size=1024};
+static Job job;
+void copy_text(char *out, size_t cap, const char *s) { snprintf(out, cap, "%s", s ? s : ""); }
+const char *json_text(const cJSON *o, const char *key) {
+    const cJSON *v=cJSON_GetObjectItemCaseSensitive(o,key);
+    return cJSON_IsString(v) ? v->valuestring : "";
+}
+void random_hex(char *out, size_t bytes) {
+    static unsigned counter;
+    memset(out,'a',bytes*2); out[bytes*2]=0; out[0]=(char)('a'+counter++);
+}
+Release *release_find(const char *id) { return !strcmp(id,release.id) ? &release : NULL; }
+bool source_enabled_locked(const Release *r) { return r == &release || !strcmp(r->id,release.id); }
+bool provider_browser_supported(const Release *r) { return r == &release; }
+bool provider_capture_url(const Release *r, const char *url) {
+    (void)r; (void)url; atomic_fetch_add(&captures,1); return true;
+}
+int probe_browser_open(const char *url) {
+    assert(!strcmp(url,"https://vikingfile.com/login"));
+    atomic_fetch_add(&opens,1); return open_result;
+}
+size_t storage_list(Storage *out) { memset(out,0,sizeof *out); copy_text(out->id,sizeof out->id,"internal");return 1; }
+Job *job_find(const char *id) { return !strcmp(id,job.id) ? &job : NULL; }
+bool job_can_refresh_link(const Job *j) { (void)j;return false; }
+int job_check_capture_locked(const Release *r,const Storage *s,char *e,size_t n) {
+    (void)r;(void)s;(void)e;(void)n;return 200;
+}
+int transfer_validate_capture(Release *r,atomic_bool *c,char *etag,char *modified,char *e,size_t n) {
+    (void)r;(void)c;(void)etag;(void)modified;(void)e;(void)n;
+    atomic_fetch_add(&validations,1);return 0;
+}
+int job_create_captured_locked(const Release *r,const Storage *s,const char *etag,const char *modified,
+                               char *e,size_t n,Job **out) {
+    (void)r;(void)s;(void)etag;(void)modified;(void)e;(void)n;
+    atomic_fetch_add(&jobs,1);copy_text(job.id,sizeof job.id,"created");*out=&job;return 201;
+}
+int job_refresh_link_locked(Job *j,const Release *r,const Storage *s,const char *etag,const char *modified,char *e,size_t n) {
+    (void)j;(void)r;(void)s;(void)etag;(void)modified;(void)e;(void)n;assert(0);return 500;
+}
+static int action(const char *body) {
+    cJSON *o=cJSON_Parse(body);assert(o);char error[256]={0};
+    int result=browser_action(o,error,sizeof error);cJSON_Delete(o);return result;
+}
+static cJSON *wait_state(const char *state, bool active) {
+    for(unsigned i=0;i<300;i++) {
+        cJSON *o=browser_status();
+        if(!strcmp(json_text(o,"state"),state) && cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(o,"active"))==active) return o;
+        cJSON_Delete(o);struct timespec t={.tv_nsec=10000000};nanosleep(&t,NULL);
+    }
+    fprintf(stderr,"Timed out waiting for %s\n",state);abort();
+}
+static void cancel_current(void) {
+    cJSON *o=browser_status();char body[160];
+    snprintf(body,sizeof body,"{\"action\":\"cancel\",\"id\":\"%s\"}",json_text(o,"id"));
+    cJSON_Delete(o);assert(action(body)==202);cJSON_Delete(wait_state("cancelled",false));
+}
+static void no_downloads(void) { assert(!atomic_load(&captures)&&!atomic_load(&validations)&&!atomic_load(&jobs)); }
+int main(void) {
+    assert(!browser_start());
+    assert(action("{\"action\":\"sign-in\",\"sourceId\":\"other\"}")==400);
+    assert(action("{\"action\":\"sign-in\",\"sourceId\":\"vikingfile\",\"nativeDialog\":true}")==400);
+    /* A caller-supplied address must never choose a sign-in destination. */
+    assert(action("{\"action\":\"sign-in\",\"sourceId\":\"vikingfile\",\"url\":\"http://127.0.0.1/private\"}")==202);
+    cJSON *o=wait_state("waiting",true);
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(o,"signIn")));cJSON_Delete(o);
+    assert(atomic_load(&opens)==1);no_downloads();
+    assert(action("{\"action\":\"sign-in\",\"sourceId\":\"vikingfile\"}")==409);
+    assert(action("{\"action\":\"cancel\",\"id\":\"stale\"}")==409);
+    pthread_mutex_lock(&orbit.mutex);browser_source_changed_locked();pthread_mutex_unlock(&orbit.mutex);
+    o=browser_status();assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(o,"active")));cJSON_Delete(o);
+    cancel_current();no_downloads();
+    assert(action("{\"action\":\"sign-in\",\"sourceId\":\"vikingfile\",\"returnTarget\":\"native\",\"nativeDialog\":true,\"clientId\":\"tv-test\"}")==202);
+    o=browser_status();char body[200];
+    assert(!strcmp(json_text(o,"pageUrl"),"https://vikingfile.com/login"));
+    snprintf(body,sizeof body,"{\"action\":\"opened\",\"id\":\"%s\",\"clientId\":\"tv-test\"}",json_text(o,"id"));
+    cJSON_Delete(o);assert(action(body)==202);cJSON_Delete(wait_state("waiting",true));
+    assert(atomic_load(&opens)==1); /* Native owns the dialog; no ShellUI launch. */
+    cancel_current();no_downloads();
+    open_result=-1;
+    assert(action("{\"action\":\"sign-in\",\"sourceId\":\"vikingfile\"}")==202);
+    cJSON_Delete(wait_state("failed",false));no_downloads();
+    /* The ordinary captured-download path still works after a sign-in session. */
+    setenv("ORBIT_TEST_CAPTURE_URL","https://vikingfile.com/d/example/file",1);
+    assert(action("{\"action\":\"start\",\"releaseId\":\"example\",\"storageId\":\"internal\"}")==202);
+    o=wait_state("queued",false);assert(!cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(o,"signIn")));cJSON_Delete(o);
+    assert(atomic_load(&captures)==1 && atomic_load(&validations)==1 && atomic_load(&jobs)==1);
+    browser_stop();puts("Vikingfile sign-in and download regression checks passed");return 0;
+}
