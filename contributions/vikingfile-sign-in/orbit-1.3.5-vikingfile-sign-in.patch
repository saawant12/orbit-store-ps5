+        opened || atomic_load(&session.cancel)
+            ? "Vikingfile sign-in session ended. Return to your download."
+            : "The PS5 browser could not open. Return to Orbit and try again.");
+    session.finished_ms = milliseconds() - session.started_ms;
+    session.busy = false;
+    memset(&session.release, 0, sizeof session.release);
+    pthread_mutex_unlock(&orbit.mutex);
