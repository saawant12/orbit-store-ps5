+import test from "node:test";
+import { mkdtempSync, writeFileSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { execFileSync } from "node:child_process";
+
+const run = (command, args) => execFileSync(command, args, { stdio: "inherit" });
+test("Vikingfile sign-in is isolated from download capture; native and browser lifecycles", () => {
+  const build = mkdtempSync(join(tmpdir(), "orbit-viking-sign-in-"));
+  try {
+    writeFileSync(join(build, "network.h"), "#define ORBIT_HTTP_PORT 34177\n");
+    // Keep strict warnings for Orbit; compile vendored cJSON independently.
+    run(process.env.CC || "clang", ["-std=c11", "-w", "-fsanitize=address,undefined",
+      "-I.deps/cjson", "-c", ".deps/cjson/cJSON.c", "-o", join(build, "cJSON.o")]);
+    run(process.env.CC || "clang", ["-std=c11", "-Wall", "-Wextra", "-Werror",
+      "-Wno-misleading-indentation", "-DORBIT_DESKTOP", "-DORBIT_TEST", "-pthread",
+      "-fsanitize=address,undefined", "-g", "-Ibackend", "-I.deps/cjson", `-I${build}`,
+      "backend/browser.c", join(build, "cJSON.o"), "tests/viking_sign_in_driver.c",
+      "-o", join(build, "backend")]);
+    run(join(build, "backend"), []);
+    run(process.env.CXX || "clang++", ["-std=c++20", "-Wall", "-Wextra", "-Werror",
+      "-fsanitize=address,undefined", "-g", "-ffunction-sections", "-fdata-sections",
+      process.platform === "darwin" ? "-Wl,-dead_strip" : "-Wl,--gc-sections",
+      "-Iapp/src", "app/src/orbit/native_provider.cpp", "app/src/orbit/api.cpp",
+      "app/src/orbit/model.cpp", "app/src/orbit/json.cpp",
+      "tests/viking_native_driver.cpp", "-o", join(build, "native")]);
+    run(join(build, "native"), []);
+  } finally {
+    rmSync(build, { recursive: true, force: true });
+  }
+});
