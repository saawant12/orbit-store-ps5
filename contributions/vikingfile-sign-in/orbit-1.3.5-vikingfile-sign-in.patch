+ * Keep the same native dialog/profile used by subsequent provider pages. */
+static void sign_in_page(void) {
+    bool opened = false;
+    if (session.native_dialog) {
+        for (unsigned i = 0; i < 300 && active(); ++i) {
+            pthread_mutex_lock(&orbit.mutex);
+            opened = session.dialog_opened;
