+import { useEffect, useState } from "react";
+import { api } from "./api";
+import type { BrowserSession } from "./types";
+import { t } from "./i18n";
+
+// Credentials and verification stay on Vikingfile's own page. This panel
+// opens that page on the PS5, including when requested from a paired device.
+export function VikingAccount({ paired }: { paired: boolean }) {
+  const [session, setSession] = useState<BrowserSession | null>(null);
+  const [pending, setPending] = useState(false);
+  const [error, setError] = useState("");
+  useEffect(() => {
+    if (!paired) return;
+    let live = true;
+    const refresh = () => {
+      api<BrowserSession>("/browser").then(
+        (next) => live && setSession(next),
+        () => live && setSession(null),
+      );
+    };
+    refresh();
+    const timer = setInterval(refresh, 2000);
+    return () => {
+      live = false;
+      clearInterval(timer);
+    };
+  }, [paired]);
+  if (!paired || !session?.signInAvailable) return null;
+  const active = session.active && session.signIn;
+  async function act() {
+    setPending(true);
+    setError("");
+    try {
+      setSession(
+        await api<BrowserSession>(
+          "/browser",
+          active
+            ? { action: "cancel", id: session!.id }
+            : {
+                action: "sign-in",
+                sourceId: "vikingfile",
+                returnTarget: "browser",
+              },
+        ),
+      );
+    } catch (e) {
+      setError((e as Error).message);
+    } finally {
+      setPending(false);
+    }
+  }
+  return (
+    <section className="updates-panel" aria-labelledby="viking-account-heading">
+      <h2 id="viking-account-heading">Vikingfile</h2>
+      <p>
+        {t("Sign in on Vikingfile, then close the page and return to Orbit.")}
+      </p>
+      <p className="fine">
+        {t(
+          "Your account hash stays in Vikingfile's browser page. Use the same Orbit interface for your download.",
+        )}
+      </p>
+      {session.signIn && <p role="status">{t(session.message)}</p>}
+      <button
+        type="button"
+        disabled={pending || (session.active && !active)}
+        onClick={() => void act()}
+      >
+        {pending ? t("Please wait…") : active ? t("Done") : t("Sign in")}
+      </button>
+      {error && (
+        <p className="form-error" role="alert">
+          {error}
+        </p>
+      )}
+    </section>
+  );
+}
